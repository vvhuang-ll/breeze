- name: clean crio
  hosts: hosts
  user: caicloud
  tasks:
  - name: remove all container images
    shell: |
      podman rmi -f $(podman images -q) || true
      podman system prune --all --force

  - name: remove crio for Redhat/CentOS
    yum:
      disablerepo: '*'
      enablerepo: wise2c-crio
      state: absent
      name: '{{ item }}'
    with_items:
    - crio
    - podman
    when: (ansible_distribution == "RedHat") or (ansible_distribution == "CentOS")

  - name: remove crio for Ubuntu
    apt:
      state: absent
      name: '{{ item }}'
    with_items:
    - cri-o
    - podman
    when: ansible_distribution =="Ubuntu"
